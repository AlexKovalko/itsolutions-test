generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String
  links       Links[]
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Links {
  id        String  @id @default(cuid())
  label     String
  url       String
  sortOrder Int     @default(0)
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, sortOrder])
}

model Skill {
  id        String  @id @default(cuid())
  name      String
  sortOrder Int     @default(0)
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, sortOrder])
}

model Company {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  url         String?
  experience  Experience[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Experience {
  id           String    @id @default(cuid())
  position     String
  startDate    DateTime
  endDate      DateTime?
  achievements String[]
  sortOrder    Int       @default(0)
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([profileId])
  @@index([profileId, sortOrder])
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String
  url         String
  sortOrder   Int     @default(0)
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, sortOrder])
}
